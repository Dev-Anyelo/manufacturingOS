generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  admin
  manager
  employee
  readonly

  @@map("user_role")
}

enum MaterialCategory {
  fabric
  supplies
  tools
  machinery

  @@map("material_category")
}

enum ContractType {
  fixed_salary
  per_piece
  hourly

  @@map("contract_type")
}

enum NotificationType {
  low_stock
  out_of_stock
  order_ready
  order_overdue
  sale_completed
  production_saved
  payment_due
  monthly_report
  inventory_updated
  expense_recorded
  order_cancelled
  attendance_late
  attendance_absent
  leave_requested
  leave_approved
  leave_rejected

  @@map("notification_type")
}

enum AuditAction {
  insert
  update
  delete

  @@map("audit_action")
}

enum InventoryMovementType {
  in
  out
  adjustment

  @@map("inventory_movement_type")
}

enum PaymentMethod {
  cash
  transfer
  credit
  mixed

  @@map("payment_method")
}

enum SaleChannel {
  in_person
  order
  whatsapp
  marketplace
  other

  @@map("sale_channel")
}

enum SaleStatus {
  paid
  partial
  pending
  cancelled

  @@map("sale_status")
}

enum WorkOrderStatus {
  received
  confirmed
  in_production
  ready
  delivered
  cancelled

  @@map("work_order_status")
}

enum WorkOrderChannel {
  in_person
  referral
  social_media
  returning_customer
  other

  @@map("work_order_channel")
}

enum ExpenseCategory {
  fabrics
  supplies
  tools
  machinery
  outsourced_labor
  services
  packaging
  office
  payroll
  other

  @@map("expense_category")
}

enum PayrollStatus {
  pending
  paid

  @@map("payroll_status")
}

enum PayrollPaymentMethod {
  cash
  transfer
  other

  @@map("payroll_payment_method")
}

enum GarmentType {
  shirt
  skirt
  shorts
  leggings
  pajamas
  suit
  sheets
  blankets
  other

  @@map("garment_type")
}

enum Currency {
  USD
  NIO

  @@map("currency")
}

model Profile {
  id                        String                 @id @db.Uuid
  fullName                  String?                @map("full_name")
  role                      UserRole               @default(employee)
  phone                     String?
  address                   String?
  birthDate                 DateTime?              @map("birth_date") @db.Date
  avatarUrl                 String?                @map("avatar_url")
  isActive                  Boolean                @default(true) @map("is_active")
  createdAt                 DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  employee                  Employee?
  notifications             Notification[]
  inventoryMovementsCreated InventoryMovement[]    @relation("InventoryMovementCreatedBy")
  productionSessionsCreated ProductionSession[]    @relation("ProductionSessionCreatedBy")
  salesCreated              Sale[]                 @relation("SaleCreatedBy")
  workOrdersCreated         WorkOrder[]            @relation("WorkOrderCreatedBy")
  expensesCreated           Expense[]              @relation("ExpenseCreatedBy")
  payrollPaymentsCreated    PayrollPayment[]       @relation("PayrollPaymentCreatedBy")
  auditLogsCreated          AuditLog[]             @relation("AuditLogCreatedBy")
  catalogMovementsCreated   CatalogMovement[]      @relation("CatalogMovementCreatedBy")
  permissionsOwned          UserModulePermission[] @relation("PermissionOwner")
  permissionsGranted        UserModulePermission[] @relation("PermissionGrantedBy")
  schedulesCreated          EmployeeSchedule[]     @relation("ScheduleCreatedBy")
  attendanceEventsCreated   AttendanceEvent[]      @relation("AttendanceEventCreatedBy")
  leaveRequestsApproved     LeaveRequest[]         @relation("LeaveApprovedBy")

  @@map("profiles")
}

model Employee {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName           String              @map("full_name")
  documentId         String              @map("document_id")
  phone              String?
  email              String?
  hireDate           DateTime            @map("hire_date") @db.Date
  contractType       ContractType        @map("contract_type")
  baseSalary         Decimal?            @map("base_salary") @db.Decimal(12, 2)
  baseSalaryCurrency Currency?           @default(USD) @map("base_salary_currency")
  isActive           Boolean             @default(true) @map("is_active")
  profileId          String?             @unique @map("profile_id") @db.Uuid
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  profile            Profile?            @relation(fields: [profileId], references: [id], onDelete: SetNull)
  productionSessions ProductionSession[]
  payrollPayments    PayrollPayment[]
  schedule           EmployeeSchedule?
  attendanceRecords  AttendanceRecord[]
  leaveRequests      LeaveRequest[]

  @@map("employees")
}

model InventoryItem {
  id                     String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                   String
  category               MaterialCategory
  fabricType             String?                 @map("fabric_type")
  color                  String?
  quantity               Decimal                 @default(0) @db.Decimal(12, 2)
  unit                   String                  @default("yd")
  unitPrice              Decimal                 @default(0) @map("unit_price") @db.Decimal(12, 2)
  unitPriceCurrency      Currency                @default(USD) @map("unit_price_currency")
  minimumStock           Decimal                 @default(0) @map("minimum_stock") @db.Decimal(12, 2)
  supplier               String?
  notes                  String?
  imageUrl               String?                 @map("image_url")
  isActive               Boolean                 @default(true) @map("is_active")
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  inventoryMovements     InventoryMovement[]
  productionSessionItems ProductionSessionItem[]
  workOrderItems         WorkOrderItem[]
  expenses               Expense[]

  @@map("inventory_items")
}

model InventoryMovement {
  id               String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inventoryItemId  String                @map("inventory_item_id") @db.Uuid
  movementType     InventoryMovementType @map("movement_type")
  quantity         Decimal               @db.Decimal(12, 2)
  previousQuantity Decimal               @map("previous_quantity") @db.Decimal(12, 2)
  newQuantity      Decimal               @map("new_quantity") @db.Decimal(12, 2)
  reason           String?
  createdBy        String?               @map("created_by") @db.Uuid
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  inventoryItem    InventoryItem         @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  createdByProfile Profile?              @relation("InventoryMovementCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  @@map("inventory_movements")
}

model Customer {
  id                     String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName               String      @map("full_name")
  phone                  String?
  email                  String?
  address                String?
  notes                  String?
  totalPurchases         Decimal     @default(0) @map("total_purchases") @db.Decimal(12, 2)
  totalPurchasesCurrency Currency    @default(USD) @map("total_purchases_currency")
  createdAt              DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  sales                  Sale[]
  workOrders             WorkOrder[]

  @@map("customers")
}

model CatalogItem {
  id                       String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                     String
  description              String?
  garmentType              String?                 @map("garment_type")
  marketPriceUnit          Decimal?                @map("market_price_unit") @db.Decimal(12, 2)
  marketPriceUnitCurrency  Currency?               @default(USD) @map("market_price_unit_currency")
  marketPriceDozen         Decimal?                @map("market_price_dozen") @db.Decimal(12, 2)
  marketPriceDozenCurrency Currency?               @default(USD) @map("market_price_dozen_currency")
  ourPriceUnit             Decimal?                @map("our_price_unit") @db.Decimal(12, 2)
  ourPriceUnitCurrency     Currency?               @default(USD) @map("our_price_unit_currency")
  ourPriceDozen            Decimal?                @map("our_price_dozen") @db.Decimal(12, 2)
  ourPriceDozenCurrency    Currency?               @default(USD) @map("our_price_dozen_currency")
  salePrice                Decimal                 @default(0) @map("sale_price") @db.Decimal(12, 2)
  salePriceCurrency        Currency                @default(USD) @map("sale_price_currency")
  estimatedCost            Decimal?                @map("estimated_cost") @db.Decimal(12, 2)
  estimatedCostCurrency    Currency?               @default(USD) @map("estimated_cost_currency")
  imageUrl                 String?                 @map("image_url")
  notes                    String?
  isActive                 Boolean                 @default(true) @map("is_active")
  createdAt                DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  saleItems                SaleItem[]
  workOrderItems           WorkOrderItem[]
  finishedGoods            FinishedGoodStock[]
  productionSessionItems   ProductionSessionItem[]

  @@map("catalog_items")
}

model ProductionSession {
  id               String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId       String                  @map("employee_id") @db.Uuid
  sessionDate      DateTime                @map("session_date") @db.Date
  totalGarments    Int                     @default(0) @map("total_garments")
  totalYardsUsed   Decimal                 @default(0) @map("total_yards_used") @db.Decimal(12, 2)
  notes            String?
  createdBy        String?                 @map("created_by") @db.Uuid
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  employee         Employee                @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  createdByProfile Profile?                @relation("ProductionSessionCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  items            ProductionSessionItem[]

  @@map("production_sessions")
}

model ProductionSessionItem {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId       String            @map("session_id") @db.Uuid
  inventoryItemId String            @map("inventory_item_id") @db.Uuid
  garmentType     GarmentType       @map("garment_type")
  size            String
  color           String?
  quantity        Int
  yardsUsed       Decimal           @map("yards_used") @db.Decimal(12, 2)
  isReuse         Boolean           @default(false) @map("is_reuse")
  notes           String?
  catalogItemId   String?           @map("catalog_item_id") @db.Uuid
  session         ProductionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem     @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  catalogItem     CatalogItem?      @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)

  @@map("production_session_items")
}

model Sale {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId          String?       @map("customer_id") @db.Uuid
  saleDate            DateTime      @map("sale_date") @db.Date
  channel             SaleChannel
  paymentMethod       PaymentMethod @map("payment_method")
  total               Decimal       @db.Decimal(12, 2)
  totalCurrency       Currency      @default(USD) @map("total_currency")
  discount            Decimal       @default(0) @db.Decimal(12, 2)
  discountCurrency    Currency      @default(USD) @map("discount_currency")
  amountPaid          Decimal       @default(0) @map("amount_paid") @db.Decimal(12, 2)
  amountPaidCurrency  Currency      @default(USD) @map("amount_paid_currency")
  changeGiven         Decimal       @default(0) @map("change_given") @db.Decimal(12, 2)
  changeGivenCurrency Currency      @default(USD) @map("change_given_currency")
  balanceDue          Decimal       @default(0) @map("balance_due") @db.Decimal(12, 2)
  status              SaleStatus    @default(pending)
  notes               String?
  createdBy           String?       @map("created_by") @db.Uuid
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  customer            Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdByProfile    Profile?      @relation("SaleCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  items               SaleItem[]

  @@map("sales")
}

model SaleItem {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  saleId              String             @map("sale_id") @db.Uuid
  catalogItemId       String?            @map("catalog_item_id") @db.Uuid
  finishedGoodStockId String?            @map("finished_good_stock_id") @db.Uuid
  description         String
  size                String?
  quantity            Int
  unitPrice           Decimal            @map("unit_price") @db.Decimal(12, 2)
  unitPriceCurrency   Currency           @default(USD) @map("unit_price_currency")
  discount            Decimal            @default(0) @db.Decimal(12, 2)
  discountCurrency    Currency           @default(USD) @map("discount_currency")
  subtotal            Decimal            @default(0) @db.Decimal(12, 2)
  sale                Sale               @relation(fields: [saleId], references: [id], onDelete: Cascade)
  catalogItem         CatalogItem?       @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)
  finishedGoodStock   FinishedGoodStock? @relation(fields: [finishedGoodStockId], references: [id], onDelete: SetNull)

  @@map("sale_items")
}

model WorkOrder {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId          String           @map("customer_id") @db.Uuid
  receivedDate        DateTime         @default(now()) @map("received_date") @db.Date
  deliveryDate        DateTime         @map("delivery_date") @db.Date
  status              WorkOrderStatus  @default(received)
  channel             WorkOrderChannel @default(in_person)
  advancePaid         Decimal          @default(0) @map("advance_paid") @db.Decimal(12, 2)
  advancePaidCurrency Currency         @default(USD) @map("advance_paid_currency")
  total               Decimal          @default(0) @db.Decimal(12, 2)
  totalCurrency       Currency         @default(USD) @map("total_currency")
  balanceDue          Decimal          @default(0) @map("balance_due") @db.Decimal(12, 2)
  reservedMaterials   Json?            @map("reserved_materials")
  referenceImages     String[]         @default([]) @map("reference_images")
  notes               String?
  cancelledReason     String?          @map("cancelled_reason")
  createdBy           String?          @map("created_by") @db.Uuid
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  customer            Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdByProfile    Profile?         @relation("WorkOrderCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  items               WorkOrderItem[]

  @@map("work_orders")
}

model WorkOrderItem {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workOrderId       String         @map("work_order_id") @db.Uuid
  catalogItemId     String?        @map("catalog_item_id") @db.Uuid
  description       String
  size              String?
  measurements      Json?
  inventoryItemId   String?        @map("inventory_item_id") @db.Uuid
  color             String?
  designNotes       String?        @map("design_notes")
  quantity          Int            @default(1)
  unitPrice         Decimal        @map("unit_price") @db.Decimal(12, 2)
  unitPriceCurrency Currency       @default(USD) @map("unit_price_currency")
  subtotal          Decimal        @default(0) @db.Decimal(12, 2)
  workOrder         WorkOrder      @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  catalogItem       CatalogItem?   @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)
  inventoryItem     InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)

  @@map("work_order_items")
}

model Expense {
  id                     String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  expenseDate            DateTime        @map("expense_date") @db.Date
  category               ExpenseCategory
  concept                String
  supplier               String?
  quantity               Decimal?        @db.Decimal(12, 2)
  unitPrice              Decimal?        @map("unit_price") @db.Decimal(12, 2)
  unitPriceCurrency      Currency?       @default(USD) @map("unit_price_currency")
  total                  Decimal         @db.Decimal(12, 2)
  totalCurrency          Currency        @default(USD) @map("total_currency")
  updatesInventory       Boolean         @default(false) @map("updates_inventory")
  inventoryItemId        String?         @map("inventory_item_id") @db.Uuid
  inventoryQuantityAdded Decimal?        @map("inventory_quantity_added") @db.Decimal(12, 2)
  receiptUrl             String?         @map("receipt_url")
  notes                  String?
  payrollPaymentId       String?         @map("payroll_payment_id") @db.Uuid
  createdBy              String?         @map("created_by") @db.Uuid
  createdAt              DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  inventoryItem          InventoryItem?  @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  payrollPayment         PayrollPayment? @relation(fields: [payrollPaymentId], references: [id], onDelete: SetNull)
  createdByProfile       Profile?        @relation("ExpenseCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  @@map("expenses")
}

model PayrollPayment {
  id                 String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId         String                @map("employee_id") @db.Uuid
  periodStart        DateTime              @map("period_start") @db.Date
  periodEnd          DateTime              @map("period_end") @db.Date
  piecesProduced     Int?                  @map("pieces_produced")
  hoursWorked        Decimal?              @map("hours_worked") @db.Decimal(8, 2)
  baseAmount         Decimal               @default(0) @map("base_amount") @db.Decimal(12, 2)
  baseAmountCurrency Currency              @default(USD) @map("base_amount_currency")
  bonuses            Decimal               @default(0) @db.Decimal(12, 2)
  bonusesCurrency    Currency              @default(USD) @map("bonuses_currency")
  deductions         Decimal               @default(0) @db.Decimal(12, 2)
  deductionsCurrency Currency              @default(USD) @map("deductions_currency")
  total              Decimal               @default(0) @db.Decimal(12, 2)
  status             PayrollStatus         @default(pending)
  paymentDate        DateTime?             @map("payment_date") @db.Date
  paymentMethod      PayrollPaymentMethod? @map("payment_method")
  notes              String?
  receiptUrl         String?               @map("receipt_url")
  createdBy          String?               @map("created_by") @db.Uuid
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  employee           Employee              @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  createdByProfile   Profile?              @relation("PayrollPaymentCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  expenses           Expense[]

  @@map("payroll_payments")
}

model Notification {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String
  body      String
  metadata  Json?
  read      Boolean          @default(false)
  expiresAt DateTime?        @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  user      Profile          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model SystemSetting {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lowStockThreshold Int      @default(10) @map("low_stock_threshold")
  baseCurrency      Currency @default(USD) @map("base_currency")
  displayCurrency   Currency @default(USD) @map("display_currency")
  timezone          String   @default("America/Managua")
  locale            String   @default("es-NI")
  companyName       String   @default("DANIELLS_CONFECCIONES") @map("company_name")
  companyPhone      String?  @map("company_phone")
  companyEmail      String?  @map("company_email")
  companyAddress    String?  @map("company_address")
  payrollDay        Int      @default(30) @map("payroll_day")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("system_settings")
}

model ExchangeRate {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fromCurrency Currency
  toCurrency   Currency
  rate         Decimal   @db.Decimal(12, 6)
  validFrom    DateTime  @map("valid_from") @db.Date
  validTo      DateTime? @map("valid_to") @db.Date
  notes        String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([fromCurrency, toCurrency, validFrom])
  @@map("exchange_rates")
}

model AuditLog {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tableName        String      @map("table_name")
  recordId         String?     @map("record_id") @db.Uuid
  action           AuditAction
  oldValues        Json?       @map("old_values")
  newValues        Json?       @map("new_values")
  createdBy        String?     @map("created_by") @db.Uuid
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  createdByProfile Profile?    @relation("AuditLogCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  @@map("audit_log")
}

model FinishedGoodStock {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  catalogItemId String      @map("catalog_item_id") @db.Uuid
  garmentType   GarmentType @map("garment_type")
  size          String
  color         String?
  stock         Int         @default(0)
  minimumStock  Int         @default(0) @map("minimum_stock")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  catalogItem CatalogItem       @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  movements   CatalogMovement[]
  saleItems   SaleItem[]

  @@unique([catalogItemId, garmentType, size, color])
  @@map("finished_good_stock")
}

model CatalogMovement {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  finishedGoodStockId String                @map("finished_good_stock_id") @db.Uuid
  movementType        InventoryMovementType @map("movement_type")
  quantity            Int
  previousQuantity    Int                   @map("previous_quantity")
  newQuantity         Int                   @map("new_quantity")
  reason              String?
  createdBy           String?               @map("created_by") @db.Uuid
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  finishedGoodStock FinishedGoodStock @relation(fields: [finishedGoodStockId], references: [id], onDelete: Restrict)
  createdByProfile  Profile?          @relation("CatalogMovementCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  @@map("catalog_movements")
}

model UserModulePermission {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  module    String
  canView   Boolean  @default(false) @map("can_view")
  canCreate Boolean  @default(false) @map("can_create")
  canEdit   Boolean  @default(false) @map("can_edit")
  canDelete Boolean  @default(false) @map("can_delete")
  canExport Boolean  @default(false) @map("can_export")
  grantedBy String?  @map("granted_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile          Profile  @relation("PermissionOwner", fields: [userId], references: [id], onDelete: Cascade)
  grantedByProfile Profile? @relation("PermissionGrantedBy", fields: [grantedBy], references: [id], onDelete: SetNull)

  @@unique([userId, module])
  @@map("user_module_permissions")
}

enum AttendanceStatus {
  on_time
  late
  early_exit
  absent
  permission
  incomplete
  no_schedule

  @@map("attendance_status")
}

enum AttendanceEventType {
  check_in
  lunch_start
  lunch_end
  check_out
  note

  @@map("attendance_event_type")
}

enum LeaveType {
  vacation
  medical
  personal
  training
  other

  @@map("leave_type")
}

enum LeaveStatus {
  pending
  approved
  rejected

  @@map("leave_status")
}

model EmployeeSchedule {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId         String   @unique @map("employee_id") @db.Uuid
  expectedCheckIn    String   @map("expected_check_in") // Formato "HH:mm"
  expectedLunchStart String?  @map("expected_lunch_start")
  expectedLunchEnd   String?  @map("expected_lunch_end")
  expectedCheckOut   String   @map("expected_check_out")
  lateTolerance      Int      @default(15) @map("late_tolerance") // Minutos
  workDays           Int[]    @map("work_days") // [1,2,3,4,5] (0=Dom, 1=Lun...)
  isActive           Boolean  @default(true) @map("is_active")
  createdBy          String?  @map("created_by") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee         Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdByProfile Profile? @relation("ScheduleCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  @@map("employee_schedules")
}

model AttendanceRecord {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId           String           @map("employee_id") @db.Uuid
  date                 DateTime         @db.Date // Un registro por día
  checkInAt            DateTime?        @map("check_in_at") @db.Timestamptz(6)
  lunchStartAt         DateTime?        @map("lunch_start_at") @db.Timestamptz(6)
  lunchEndAt           DateTime?        @map("lunch_end_at") @db.Timestamptz(6)
  checkOutAt           DateTime?        @map("check_out_at") @db.Timestamptz(6)
  status               AttendanceStatus
  checkInLateMinutes   Int?             @map("check_in_late_minutes")
  lunchOvertimeMinutes Int?             @map("lunch_overtime_minutes")
  earlyExitMinutes     Int?             @map("early_exit_minutes")
  totalWorkedMinutes   Int?             @map("total_worked_minutes")
  notes                String?
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  events   AttendanceEvent[]

  @@unique([employeeId, date])
  @@map("attendance_records")
}

model AttendanceEvent {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attendanceRecordId String              @map("attendance_record_id") @db.Uuid
  eventType          AttendanceEventType @map("event_type")
  happenedAt         DateTime            @map("happened_at") @db.Timestamptz(6)
  reason             String?             // Obligatorio para excepciones
  createdBy          String?             @map("created_by") @db.Uuid // Quien generó el evento (empleado o admin)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  attendanceRecord AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)
  createdByProfile Profile?         @relation("AttendanceEventCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  @@map("attendance_events")
}

model LeaveRequest {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId   String      @map("employee_id") @db.Uuid
  leaveDate    DateTime    @map("leave_date") @db.Date
  leaveType    LeaveType   @map("leave_type")
  reason       String
  status       LeaveStatus @default(pending)
  approvedBy   String?     @map("approved_by") @db.Uuid
  approvalNote String?     @map("approval_note")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee          Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  approvedByProfile Profile? @relation("LeaveApprovedBy", fields: [approvedBy], references: [id], onDelete: SetNull)

  @@unique([employeeId, leaveDate])
  @@map("leave_requests")
}

