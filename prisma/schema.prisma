generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider  = "postgresql"
    url       = env("DATABASE_URL")
    directUrl = env("DIRECT_URL")
}

enum UserRole {
    admin
    manager
    employee
    readonly
}

enum MaterialCategory {
    fabric
    supplies
    tools
    machinery
}

enum ContractType {
    fixed_salary
    per_piece
    hourly
}

enum NotificationType {
    low_stock
    out_of_stock
    order_ready
    order_overdue
    sale_completed
    production_saved
    payment_due
    monthly_report
    inventory_updated
}

enum AuditAction {
    insert
    update
    delete
}

enum InventoryMovementType {
    in
    out
    adjustment
}

model Profile {
    id            String         @id @db.Uuid
    fullName      String?        @map("full_name")
    role          UserRole       @default(employee)
    phone         String?
    avatarUrl     String?        @map("avatar_url")
    isActive      Boolean        @default(true) @map("is_active")
    createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
    employee      Employee?
    notifications Notification[]

    @@map("profiles")
}

model Employee {
    id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    fullName     String       @map("full_name")
    documentId   String?      @map("document_id")
    phone        String?
    email        String?
    hireDate     DateTime     @map("hire_date") @db.Date
    contractType ContractType @map("contract_type")
    baseSalary   Decimal?     @map("base_salary") @db.Decimal(12, 2)
    isActive     Boolean      @default(true) @map("is_active")
    profileId    String?      @unique @map("profile_id") @db.Uuid
    createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
    profile      Profile?     @relation(fields: [profileId], references: [id], onDelete: SetNull)

    @@map("employees")
}

model InventoryItem {
    id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    name               String
    category           MaterialCategory
    fabricType         String?             @map("fabric_type")
    color              String?
    quantity           Decimal             @default(0) @db.Decimal(12, 2)
    unit               String              @default("yd")
    unitPrice          Decimal             @default(0) @map("unit_price") @db.Decimal(12, 2)
    minimumStock       Decimal             @default(0) @map("minimum_stock") @db.Decimal(12, 2)
    supplier           String?
    notes              String?
    imageUrl           String?             @map("image_url")
    isActive           Boolean             @default(true) @map("is_active")
    createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
    inventoryMovements InventoryMovement[]

    @@map("inventory_items")
}

model InventoryMovement {
    id               String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    inventoryItemId  String                @map("inventory_item_id") @db.Uuid
    movementType     InventoryMovementType @map("movement_type")
    quantity         Decimal               @db.Decimal(12, 2)
    previousQuantity Decimal               @map("previous_quantity") @db.Decimal(12, 2)
    newQuantity      Decimal               @map("new_quantity") @db.Decimal(12, 2)
    reason           String?
    createdBy        String?               @map("created_by") @db.Uuid
    createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
    inventoryItem    InventoryItem         @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

    @@map("inventory_movements")
}

model Customer {
    id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    fullName       String   @map("full_name")
    phone          String?
    email          String?
    address        String?
    notes          String?
    totalPurchases Decimal  @default(0) @map("total_purchases") @db.Decimal(12, 2)
    createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

    @@map("customers")
}

model CatalogItem {
    id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    name          String
    description   String?
    salePrice     Decimal  @map("sale_price") @db.Decimal(12, 2)
    estimatedCost Decimal? @map("estimated_cost") @db.Decimal(12, 2)
    isActive      Boolean  @default(true) @map("is_active")
    createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

    @@map("catalog_items")
}

model Notification {
    id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    userId    String           @map("user_id") @db.Uuid
    type      NotificationType
    title     String
    body      String
    metadata  Json?
    read      Boolean          @default(false)
    expiresAt DateTime?        @map("expires_at") @db.Timestamptz(6)
    createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
    user      Profile          @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@map("notifications")
}

model SystemSetting {
    id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    lowStockThreshold Int      @default(10) @map("low_stock_threshold")
    currency          String   @default("USD")
    timezone          String   @default("America/Panama")
    companyName       String   @default("manufacturingOS") @map("company_name")
    companyPhone      String?  @map("company_phone")
    companyEmail      String?  @map("company_email")
    companyAddress    String?  @map("company_address")
    createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

    @@map("system_settings")
}

model AuditLog {
    id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    tableName String      @map("table_name")
    recordId  String?     @map("record_id") @db.Uuid
    action    AuditAction
    oldValues Json?       @map("old_values")
    newValues Json?       @map("new_values")
    createdBy String?     @map("created_by") @db.Uuid
    createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

    @@map("audit_log")
}
